---
// Marca provisional en texto. Reemplazar por el SVG oficial del laboratorio en /public/logo.svg
// (<img src="/logo.svg" alt="J&M Las Garzas" width="160" height="48" />).
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class="inline-flex items-center gap-3">
  <span class={`grid h-11 w-11 place-items-center rounded-lg text-lg font-bold ${light ? 'bg-white text-brand-900' : 'bg-brand-900 text-white'}`} aria-hidden="true">JM</span>
  <span class="leading-tight">
    <span class={`block text-lg font-bold ${light ? 'text-white' : 'text-brand-900'}`}>Laboratorio J&amp;M</span>
    <span class={`block text-sm ${light ? 'text-brand-100' : 'text-accent-700'}`}>Las Garzas</span>
  </span>
</span>
