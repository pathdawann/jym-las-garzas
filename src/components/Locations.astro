---
import { LOCATIONS, HOME_SERVICE_ZONES, SITE, waLink } from '../data/site';
const mapsUrl = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---
<section id="sedes" aria-labelledby="sedes-title" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 id="sedes-title" class="section-title">Dónde estamos</h2>
    <p class="section-lead">Visítanos o pide que vayamos a tu casa.</p>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      {LOCATIONS.map((loc) => (
        <article class="rounded-2xl border border-slate-300 bg-slate-50 p-6 sm:p-8">
          <h3 class="text-2xl font-bold">{loc.name}</h3>
          <p class="mt-2 text-lg text-slate-700">{loc.address}</p>

          <h4 class="mt-6 font-bold text-slate-900">Horario de atención</h4>
          <dl class="mt-2 space-y-1 text-lg">
            {loc.hours.map((h) => (
              <div class="flex justify-between gap-4 border-b border-slate-200 py-2"><dt>{h.days}</dt><dd class="font-bold">{h.time}</dd></div>
            ))}
          </dl>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href={mapsUrl(loc.mapsQuery)} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Ver ubicación en el mapa<span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
            <a href={waLink(`Hola, tengo una consulta sobre la sede ${loc.name}.`)} class="btn btn-wa">Escribir por WhatsApp</a>
            <a href={`tel:${SITE.phoneE164}`} class="btn btn-secondary">Llamar al {SITE.phoneDisplay}</a>
          </div>
        </article>
      ))}

      <aside class="rounded-2xl border border-accent-100 bg-accent-50 p-6 sm:p-8">
        <h3 class="text-2xl font-bold">Toma de muestra a domicilio</h3>
        <p class="mt-2 text-lg text-slate-700">Sin costo adicional en zonas céntricas de:</p>
        <ul class="mt-3 space-y-1 text-lg font-bold text-brand-900">
          {HOME_SERVICE_ZONES.map((z) => <li>{z}</li>)}
        </ul>
        <ol class="mt-5 list-decimal space-y-1 pl-6 text-lg text-slate-700">
          <li>Escríbenos por WhatsApp.</li>
          <li>Dinos qué exámenes necesitas.</li>
          <li>Coordinamos día y hora.</li>
        </ol>
        <a href={waLink('Hola, quiero solicitar toma de muestra a domicilio.')} class="btn btn-wa mt-6">Solicitar visita</a>
      </aside>
    </div>
  </div>
</section>
