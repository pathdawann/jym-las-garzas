---
/**
 * Buscador de exámenes en tiempo real (JavaScript nativo, sin librerías).
 * - Los datos viajan como JSON embebido: 0 peticiones de red, respuesta instantánea.
 * - Búsqueda insensible a acentos/mayúsculas, con sinónimos (aliases) y todos los términos requeridos (AND).
 * - Accesible: <label> real, resultados anunciados con aria-live, todo operable con teclado.
 * - Seguro: se renderiza solo con textContent (nunca innerHTML) → sin riesgo de XSS.
 */
import { supabase } from '../lib/supabase';
import { waLink } from '../data/site';

// 1. Astro extrae los datos directamente desde Supabase
const { data: EXAMS } = await supabase.from('catalogo_examenes').select('*');

// 2. Envuelve los datos para el buscador en tiempo real
const payload = JSON.stringify(EXAMS || []).replace(/</g, '\\u003c');

// 3. Filtra automáticamente las pruebas marcadas como frecuentes (máximo 12)
const suggestions = (EXAMS || [])
  .filter(e => e.is_frequent)
  .map(e => e.name)
  .slice(0, 12);
---

<section id="examenes" aria-labelledby="examenes-title" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <h2 id="examenes-title" class="section-title">¿Qué examen te indicó tu médico?</h2>
    <p class="section-lead">Escríbelo y te decimos cómo prepararte: ayuno, tipo de muestra y recomendaciones.</p>

    <div id="exam-search" class="mt-8" data-wa-base={waLink()}>
      <label for="exam-q" class="block text-lg font-bold text-slate-900">Nombre del examen</label>
      <input id="exam-q" type="search" autocomplete="off" spellcheck="false" class="field"
        placeholder="Ejemplo: perfil 20, glucosa, hematicograma"
        aria-describedby="exam-hint" aria-controls="exam-results" />
      <p id="exam-hint" class="mt-2 text-slate-600">Escribe al menos 2 letras. No necesitas acentos.</p>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-slate-700">Búsquedas frecuentes:</span>
        {suggestions.map((s) => (
          <button type="button" data-suggest={s}
            class="min-h-11 rounded-full border-2 border-brand-200 bg-brand-50 px-4 font-bold text-brand-800 hover:border-brand-700">{s}</button>
        ))}
      </div>

      <p id="exam-status" role="status" aria-live="polite" class="mt-6 min-h-7 text-lg font-bold text-slate-800"></p>
      <ul id="exam-results" class="mt-2 grid gap-4"></ul>
    </div>

    <script id="exam-data" type="application/json" set:html={payload} />
  </div>
</section>

<script>
  interface Exam { id: string; name: string; aliases: string[]; category: string; sample: string; fasting: string; preparation: string[] }

  const root = document.getElementById('exam-search');
  if (root) {
    const exams: Exam[] = JSON.parse(document.getElementById('exam-data')?.textContent ?? '[]');
    const input = root.querySelector<HTMLInputElement>('#exam-q')!;
    const status = root.querySelector<HTMLElement>('#exam-status')!;
    const list = root.querySelector<HTMLElement>('#exam-results')!;
    const waBase = root.dataset.waBase ?? '';

    // "Glucémia" → "glucemia": quita acentos y mayúsculas para comparar.
    const normalize = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    // Índice precalculado una sola vez (evita normalizar en cada tecla).
    const index = exams.map((exam) => ({
      exam,
      name: normalize(exam.name),
      aliases: exam.aliases.map(normalize),
      category: normalize(exam.category),
    }));

    // Puntuación por término: nombre empieza (5) > nombre contiene (3) > sinónimo (2) > categoría (1).
    // Si algún término no coincide, el examen se descarta (búsqueda AND).
    function search(query: string): Exam[] {
      const tokens = normalize(query).split(/\s+/).filter(Boolean);
      return index
        .map((item) => {
          let total = 0;
          for (const t of tokens) {
            const s = item.name.startsWith(t) ? 5 : item.name.includes(t) ? 3 : item.aliases.some((a) => a.includes(t)) ? 2 : item.category.includes(t) ? 1 : 0;
            if (!s) return { exam: item.exam, score: 0 };
            total += s;
          }
          return { exam: item.exam, score: total };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score)
        .map((r) => r.exam);
    }

    // Helper DOM seguro: siempre textContent.
    function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) {
      const node = document.createElement(tag);
      node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function whatsappLink(label: string) {
      const a = el('a', 'btn btn-wa mt-4', 'Agendar por WhatsApp');
      a.href = `${waBase}?text=${encodeURIComponent(`Hola, quiero agendar: ${label}`)}`;
      a.rel = 'noopener';
      return a;
    }

    function card(exam: Exam) {
      const li = el('li', '');
      const article = el('article', 'rounded-2xl border border-slate-300 bg-slate-50 p-6');
      const head = el('div', 'flex flex-wrap items-start justify-between gap-3');
      head.append(el('h3', 'text-xl font-bold', exam.name), el('span', 'rounded-md bg-accent-50 px-3 py-1 text-sm font-bold text-accent-700', exam.category));

      const facts = el('dl', 'mt-4 grid gap-4 sm:grid-cols-2');
      for (const [label, value] of [['Ayuno', exam.fasting], ['Muestra', exam.sample]]) {
        const box = el('div', '');
        box.append(el('dt', 'text-sm text-slate-600', label), el('dd', 'text-lg font-bold text-brand-900', value));
        facts.append(box);
      }

      const tips = el('ul', 'mt-4 list-disc space-y-1 pl-6 text-lg text-slate-700');
      exam.preparation.forEach((t) => tips.append(el('li', '', t)));

      article.append(head, facts, el('h4', 'mt-5 font-bold text-slate-900', 'Recomendaciones'), tips, whatsappLink(exam.name));
      li.append(article);
      return li;
    }

    function render() {
      const q = input.value;
      list.replaceChildren();
      if (normalize(q).length < 2) { status.textContent = ''; return; }

      const results = search(q);
      if (results.length === 0) {
        status.textContent = 'No encontramos ese examen en la lista.';
        const li = el('li', 'rounded-2xl border border-slate-300 bg-slate-50 p-6 text-lg');
        li.append(el('p', '', 'Puede que se llame distinto. Escríbenos y te orientamos:'), whatsappLink(q.trim()));
        list.append(li);
        return;
      }
      status.textContent = results.length === 1 ? '1 resultado' : `${results.length} resultados`;
      results.forEach((e) => list.append(card(e)));
    }

    // Debounce corto: fluido en teléfonos de gama baja sin renderizar en cada tecla.
    let timer: number | undefined;
    input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(render, 120); });

    root.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) =>
      b.addEventListener('click', () => { input.value = b.dataset.suggest ?? ''; render(); input.focus(); }));

    // Permite enlaces profundos desde las tarjetas de servicios: /?q=adn#examenes
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { input.value = initial.slice(0, 60); render(); }
  }
</script>
