---
import { SERVICES } from '../data/services';
---
<section id="servicios" aria-labelledby="servicios-title" class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="servicios-title" class="section-title">Todas las pruebas en un solo lugar</h2>
    <p class="section-lead">Abre una categoría para ver ejemplos de estudios y ve directo al buscador.</p>

    <!-- <details> nativo: se abre con Enter/Espacio, lo anuncian los lectores de pantalla y no requiere JS. -->
    <div class="mt-10 grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((s) => (
        <details class="group rounded-2xl border border-slate-300 bg-white open:border-brand-700 open:shadow-md">
          <summary class="flex min-h-20 cursor-pointer list-none items-center gap-4 rounded-2xl p-5 [&::-webkit-details-marker]:hidden">
            <span aria-hidden="true" class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-50 text-2xl">{s.icon}</span>
            <span class="flex-1 text-lg font-bold text-brand-900">{s.title}</span>
            <span aria-hidden="true" class="text-2xl font-bold text-brand-700 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="px-5 pb-5">
            <p class="text-lg text-slate-700">{s.summary}</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {s.examples.map((e) => <li class="rounded-md bg-slate-100 px-3 py-1 text-slate-800">{e}</li>)}
            </ul>
            <a href={`/?q=${encodeURIComponent(s.query)}#examenes`} class="mt-4 inline-block font-bold text-brand-700 underline underline-offset-4 hover:text-brand-900">
              Ver estudios de {s.title.toLowerCase()}
            </a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
