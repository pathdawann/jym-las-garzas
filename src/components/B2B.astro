---
import { waLink } from '../data/site';
// TODO: validar con el laboratorio qué convenios y modalidades ofrece realmente.
const items = [
  { title: 'Convenios corporativos', text: 'Acuerdos con tarifas preferenciales para el personal de tu empresa.' },
  { title: 'Exámenes de ingreso', text: 'Perfiles preempleo para nuevos trabajadores, con resultados claros.' },
  { title: 'Controles preventivos', text: 'Chequeos periódicos para cuidar la salud del equipo y detectar a tiempo.' },
  { title: 'Entrega confidencial', text: 'Los resultados se entregan por un canal seguro y solo a quien corresponde.' },
];
---
<section id="empresas" aria-labelledby="empresas-title" class="bg-brand-900 py-16 text-white sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 id="empresas-title" class="section-title !text-white">Salud ocupacional para empresas</h2>
    <p class="mt-3 max-w-2xl text-lg text-brand-100">Cuidamos la salud de tus trabajadores con estudios confiables y atención coordinada.</p>

    <dl class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {items.map((i) => (
        <div class="border-l-4 border-accent-500 pl-5">
          <dt class="text-xl font-bold">{i.title}</dt>
          <dd class="mt-1 text-lg text-brand-100">{i.text}</dd>
        </div>
      ))}
    </dl>

    <a href={waLink('Hola, represento a una empresa y quiero una propuesta de convenio de salud ocupacional.')}
       class="btn mt-10 bg-white text-brand-900 hover:bg-brand-100">Solicitar propuesta para mi empresa</a>
  </div>
</section>
