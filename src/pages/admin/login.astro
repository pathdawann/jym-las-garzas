---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Acceso Administrativo | J&M Las Garzas">
  <main class="flex min-h-screen items-center justify-center bg-slate-50 p-4">
    <div class="w-full max-w-md rounded-2xl border border-slate-300 bg-white p-8 shadow-sm">
      <h1 class="text-2xl font-bold text-brand-900">Acceso al Sistema</h1>
      <p class="mt-2 text-slate-600">Ingresa tus credenciales administrativas.</p>

      <form id="login-form" class="mt-6 space-y-4">
        <div>
          <label for="email" class="block font-bold text-slate-800">Correo electrónico</label>
          <input type="email" id="email" required class="field" />
        </div>
        <div>
          <label for="password" class="block font-bold text-slate-800">Contraseña</label>
          <input type="password" id="password" required class="field" />
        </div>
        <p id="error-msg" class="hidden text-sm font-bold text-red-700"></p>
        <button type="submit" id="submit-btn" class="btn btn-primary w-full">Iniciar sesión</button>
      </form>
    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Verificando...';
    
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      errorMsg.textContent = 'Credenciales incorrectas. Intenta de nuevo.';
      errorMsg.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Iniciar sesión';
    } else {
      // Si el login es exitoso, redirige al panel de control
      window.location.href = '/admin/dashboard';
    }
  });
</script>