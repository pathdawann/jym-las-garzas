import ResultsPortal from '../components/ResultsPortal.astro';
import Locations from '../components/Locations.astro';
import B2B from '../components/B2B.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <ExamSearch />
    <Services />
    <ResultsPortal />
    <Locations />
    <B2B />
  </main>
  <Footer />
</BaseLayout>
